# Data layers are reproducible from src/ and are not tracked.
data/raw/*
!data/raw/.gitkeep

# data/field/ is NOT ignored: those records cannot be regenerated.

# Large geospatial inputs
*.tif
*.tiff
*.geotiff
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.zarr/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# Notebooks
.ipynb_checkpoints/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini
